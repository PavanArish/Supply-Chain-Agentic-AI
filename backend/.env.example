# --- Database ---
# Default: SQLite, zero setup, works immediately.
DATABASE_URL=sqlite:///./storage/app.db

# To use MySQL instead, comment the line above and uncomment/edit this one:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/supply_chain_agent

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM (optional — Gemini, Groq, and/or Grok) ---
# All optional. If none are set, the orchestrator and agents fall back
# to rule-based logic so the app is fully usable without any API key/cost.
# If more than one is set, priority is: Gemini, then Groq, then Grok.

# Google Gemini — free tier. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq — groq.com's fast-inference API (Llama/Mixtral), free tier.
# Get a key at https://console.groq.com/keys
# NOTE: this is NOT the same service as "Grok" (xAI) below — easy to mix up.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Grok (xAI) — get a key at https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# --- External services (stubs, optional) ---
NEWS_API_KEY=
MAPS_API_KEY=

# --- Storage ---
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
